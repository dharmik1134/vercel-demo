# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# LLM Provider API Keys (Add at least one to enable live LLM generation)
# Get Gemini key: https://aistudio.google.com/
GEMINI_API_KEY=
# Get OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Vector Database & Storage
CHROMA_PERSIST_DIR=./database/chroma_db
COLLECTION_NAME=charusat_knowledge_base
SQLITE_DB_PATH=./database/app.sqlite3

# RAG Hyperparameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
