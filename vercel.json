{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/egovernance",
      "destination": "/egovernance.html"
    },
    {
      "source": "/egov",
      "destination": "/egovernance.html"
    }
  ]
}
