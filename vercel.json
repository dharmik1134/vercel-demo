{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/egovernance",
      "destination": "/frontend/egovernance.html"
    },
    {
      "source": "/egov",
      "destination": "/frontend/egovernance.html"
    },
    {
      "source": "/widget.js",
      "destination": "/frontend/widget.js"
    },
    {
      "source": "/charusatAIassistant/(.*)",
      "destination": "/frontend/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
